{
  "name": "@cyberia-modulus/qr-scan-core",
  "version": "0.1.0",
  "description": "Framework-neutral physical QR scanner with camera, ROI gestures, radial zoom, and host-controlled extension points.",
  "type": "module",
  "main": "./dist/qr-scan-core.js",
  "module": "./dist/qr-scan-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/qr-scan-core.js"
    },
    "./style.css": "./dist/qr-scan-core.css"
  },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --config vite.harness.config.ts --configLoader runner",
    "test": "node ./node_modules/vitest/vitest.mjs run --configLoader runner",
    "build:lib": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json && node ./node_modules/vite/bin/vite.js build --configLoader runner",
    "build:harness": "node ./node_modules/vite/bin/vite.js build --config vite.harness.config.ts --configLoader runner",
    "build": "npm run build:lib && npm run build:harness"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
