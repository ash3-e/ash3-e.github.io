        ctx.strokeStyle = colors[i];
        ctx.lineWidth = 2.2;
        ctx.globalAlpha = 0.92;
        ctx.stroke();
        ctx.beginPath();
        for(let x=0;x<=innerWidth;x+=8){
          const nx = x / innerWidth;
          const envelope = Math.sin(Math.PI * nx);
          const standing = Math.sin((Math.PI * mode * nx) + phase) * Math.cos(phase * (1.4 + i * 0.13));
          const yy = y + standing * envelope * amp;
          if(x===0) ctx.moveTo(x,yy); else ctx.lineTo(x,yy);
        }
        ctx.strokeStyle = colors[i];
        ctx.lineWidth = 7;
        ctx.globalAlpha = 0.065;
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  const search=document.getElementById('search');
  const parts=[...document.querySelectorAll('.part-card')];
  if(search){
    search.addEventListener('input',()=>{
      const q=search.value.trim().toLowerCase();
      parts.forEach(p=>{
        const hit=!q||p.textContent.toLowerCase().includes(q);
        p.style.display=hit?'':'none';
        if(q&&hit) p.open=true;
      });
    });
  }
  function syncMobile(){
    if(matchMedia('(max-width: 720px)').matches){
      parts.forEach((p,i)=>{ if(!p.dataset.mobileTouched){ p.open=i===0; p.dataset.mobileTouched='1'; } });
    } else {
      parts.forEach(p=>p.open=true);
    }
  }
  syncMobile();
  addEventListener('resize',syncMobile,{passive:true});

  const overlay=document.getElementById('diagramViewer');
  const preview=document.getElementById('diagramPreviewImage');
  const title=document.getElementById('diagramViewerTitle');
  const sub=document.getElementById('diagramViewerSub');
  const save=document.getElementById('diagramSave');
  const close=document.getElementById('diagramClose');
  function openDiagram(fig){
    if(!overlay || !preview || !fig) return;
    const img=fig.querySelector('img');
    const caption=fig.dataset.caption || fig.querySelector('figcaption')?.textContent?.trim() || img?.alt || 'Diagram preview';
    const src=fig.dataset.src || img?.src || '';
    preview.src=src;
    preview.alt=img?.alt || caption;
    if(title) title.textContent=caption;
    if(sub) sub.textContent='Full-screen diagram preview';
    if(save){ save.href=src; save.download=(caption||'diagram').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')+'.svg'; }
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden','false');
    document.body.classList.add('diagram-viewer-open');
  }
  function closeDiagram(){
    if(!overlay) return;
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden','true');
    document.body.classList.remove('diagram-viewer-open');
    if(preview) preview.removeAttribute('src');
  }
  document.querySelectorAll('.diagram-card').forEach(fig=>{
    fig.addEventListener('click', e=>{ e.preventDefault(); openDiagram(fig); });
    fig.addEventListener('keydown', e=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); openDiagram(fig); } });
  });
  close?.addEventListener('click', closeDiagram);
  overlay?.addEventListener('click', e=>{ if(e.target===overlay) closeDiagram(); });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape' && overlay?.classList.contains('open')) closeDiagram(); });

  animateWaves();
})();
</script></body>
</html>
